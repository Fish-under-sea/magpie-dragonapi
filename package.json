{
  "name": "@fish-under-sea/magpie-dragonapi",
  "version": "0.2.0",
  "description": "DragonAPI for magpie: a provider plugin whose models, groups and prices come from the site's public /api/pricing, with balance and per-call usage from an sk- key, plus a local page that lists the market (read-only), shows usage and can mint new keys for a group.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./page": "./page/index.html"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"tests/*.test.mjs\"",
    "serve": "node serve.mjs"
  },
  "license": "MIT",
  "files": [
    "index.mjs",
    "lib",
    "page",
    "ui",
    "serve.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-provider",
    "magpie-page",
    "opencode-plugin",
    "dragonapi",
    "new-api",
    "relay"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fish-under-sea/magpie-dragonapi.git"
  },
  "homepage": "https://github.com/Fish-under-sea/magpie-dragonapi#readme",
  "bugs": {
    "url": "https://github.com/Fish-under-sea/magpie-dragonapi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "magpie": {
    "icon": "page/icon.svg",
    "name": "DragonAPI",
    "summary": {
      "zh": "把 DragonAPI 接进 magpie：模型目录、余额与用量，外加一个按分组建钥匙的本地控制台。",
      "en": "DragonAPI for magpie: model catalog, balance and usage, plus a local console for minting per-group keys."
    },
    "page": {
      "title": "DragonAPI",
      "titles": {
        "zh": "DragonAPI",
        "zh-TW": "DragonAPI",
        "ja": "DragonAPI",
        "de": "DragonAPI"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3517,
        "option": "port"
      }
    },
    "options": {
      "port": 3517,
      "site": "https://newapi.dragon3api.com"
    }
  }
}
